  m_Script: {fileID: 11500000, guid: e34961fe4532a3f489d5b403c26f48eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AlingNena
  rb: {fileID: 0}
  animator: {fileID: 0}
  dialogues:
  - DialogueName: Quest 1
    dialogueLines:
    - characterName: Ikaw
      line: Kamusta, maaari ko bang maitanong kung saan ba dito ang bahay ng albularyo?
    - characterName: Aling Nena
      line: Ang Albularyo? Huwag kang pupunta doon nang walang baon na dasal, nak.
    - characterName: Aling Nena
      line: Pero kung desidido ka, hanapin mo ang kubong may mga nakasabit na tuyong
        bawang sa kakahuyan.
  - DialogueName: Ikatlong Araw (Filler)
    dialogueLines:
    - characterName: Ikaw
      line: Mag-iingat ka apo.
  dialogueIndex: 0
  moves: []
  moveSpeed: 5
