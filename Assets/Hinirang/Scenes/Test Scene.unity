      objectReference: {fileID: 0}
    - target: {fileID: 8946070191782132713, guid: ed8e2d54f72d44f42a56253d21a5cc3d, type: 3}
      propertyPath: dialogues.Array.data[0].dialogueLines.Array.data[11].line
      value: "Hindi ito sapat para iligtas ka sa mga tatahakin mo, pero sapat na
        ito para mabuhay ka ngayong gabi. Sige na umalis ka na bago pa lumalim ang
        gabi\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8946070191782132713, guid: ed8e2d54f72d44f42a56253d21a5cc3d, type: 3}
      propertyPath: dialogues.Array.data[0].dialogueLines.Array.data[12].line
      value: 'Osiya sige na, ngunit kunin mo itong sanga ng Kamagong at itong Anting-anting. '
      objectReference: {fileID: 0}
