  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65a06f3d9d7686c429eab5a0cac7c29f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCScript
  rb: {fileID: 0}
  animator: {fileID: 0}
  dialogues:
  - DialogueName: Quest 1
    dialogueLines:
    - characterName: Ikaw
      line: Kamusta, maaari ko bang maitanong kung saan ba dito ang bahay ng albularyo?
    - characterName: Aling Nena
      line: Ang Albularyo? Huwag kang pupunta doon nang walang baon na dasal, nak.
    - characterName: Aling Nena
      line: Pero kung desidido ka, hanapin mo ang kubong may mga nakasabit na tuyong
        bawang sa kakahuyan.
  - DialogueName: Quest 2
    dialogueLines:
    - characterName: Ikaw
      line: Good day panelists.
    - characterName: Aling Nena
      line: Who is the beneficiaries of your study and how will they benefit from
        this?
  dialogueIndex: 0
  moves: []
  moveSpeed: 5
